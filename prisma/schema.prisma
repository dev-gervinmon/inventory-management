// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id String @id @default(cuid())
  userId String
  name String
  sku String? @unique
  price Decimal @db.Decimal(12, 2)
  unitCost Decimal? @db.Decimal(12, 2)
  quantity Int @default(0)
  lowStockAt Int?
  imageUrl String?
  categories Category[] @relation("Categories")
  subcategories Subcategory[] @relation("ProductSubcategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, name])
  @@index([createdAt])
  stockMovements StockMovement[]
}

model Category {
  id String @id @default(cuid())
  name String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("Categories")
  subcategories Subcategory[]
}

model Subcategory {
  id String @id @default(cuid())
  name String
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[] @relation("ProductSubcategories")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, categoryId])
}

model Activity {
  id String @id @default(cuid())
  userId String
  entityType String // "PRODUCT", "CATEGORY", "SUBCATEGORY"
  actionType String // "ADDED", "EDITED", "DELETED", "STOCK_UPDATED", "PRICE_UPDATED"
  entityId String? // ID of the product, category, or subcategory
  entityName String // Name of the product, category, or subcategory
  message String
  details Json? // stores old/new values for changes
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, createdAt])
}

model StockMovement {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  direction String
  source String?
  reason String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model InventoryValueSnapshot {
  id String @id @default(cuid())
  userId String
  snapshotDate DateTime @db.Date
  totalRetailValue Decimal @db.Decimal(14, 2)
  totalCostValue Decimal @db.Decimal(14, 2)
  totalPotentialProfit Decimal @db.Decimal(14, 2)
  productsMissingCost Int
  createdAt DateTime @default(now())

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}

model InventoryHealthSnapshot {
  id String @id @default(cuid())
  userId String
  snapshotDate DateTime @db.Date
  totalProducts Int
  inStockCount Int
  lowStockCount Int
  outOfStockCount Int
  createdAt DateTime @default(now())

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate])
}